generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  domain        String   @unique @db.VarChar(255)
  defaultLocale String   @default("ar") @map("default_locale") @db.VarChar(5)
  currency      String   @default("EUR") @db.VarChar(3)
  status        String   @default("active") @db.VarChar(20)
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings StoreSettings?
  users    User[]

  @@map("stores")
}

model StoreSettings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String   @unique @map("store_id") @db.Uuid
  invoicePrefix      String   @map("invoice_prefix") @db.VarChar(20)
  nextInvoiceNumber  BigInt   @default(1) @map("next_invoice_number")
  vatRate            Decimal  @default(0.19) @map("vat_rate") @db.Decimal(5, 4)
  vatIncludedInPrice Boolean  @default(true) @map("vat_included_in_price")
  markupPercentage   Decimal  @default(45.00) @map("markup_percentage") @db.Decimal(5, 2)
  allowedLocales     String[] @default(["ar", "en", "de"]) @map("allowed_locales")
  refundWindowDays   Int      @default(14) @map("refund_window_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String?   @map("store_id") @db.Uuid
  email           String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String?   @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  role            String    @default("customer") @db.VarChar(20)
  status          String    @default("active") @db.VarChar(20)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  tokenVersion    Int       @default(0) @map("token_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store     Store?        @relation(fields: [storeId], references: [id])
  sessions  UserSession[]
  addresses Address[]

  @@unique([storeId, email])
  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  storeId          String?   @map("store_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([storeId])
  @@map("user_sessions")
}

model Address {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  countryCode   String    @map("country_code") @db.VarChar(2)
  city          String    @db.VarChar(100)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  addressLine1  String    @map("address_line1") @db.VarChar(255)
  addressLine2  String?   @map("address_line2") @db.VarChar(255)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, storeId])
  @@index([storeId])
  @@map("addresses")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  connections      SupplierConnection[]
  products         Product[]
  supplierProducts SupplierProduct[]

  @@map("suppliers")
}

model SupplierConnection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId            String    @map("supplier_id") @db.Uuid
  storeId               String?   @map("store_id") @db.Uuid
  status                String    @default("disconnected") @db.VarChar(20)
  accessTokenEncrypted  String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at") @db.Timestamptz(6)
  lastVerifiedAt        DateTime? @map("last_verified_at") @db.Timestamptz(6)
  lastError             String?   @map("last_error") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, storeId])
  @@map("supplier_connections")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryHierarchy")
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  locale      String  @db.VarChar(5)
  name        String  @db.VarChar(255)
  description String? @db.Text

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId   String    @map("supplier_id") @db.Uuid
  slug         String    @unique @db.VarChar(255)
  brand        String?   @db.VarChar(100)
  status       String    @default("active") @db.VarChar(20)
  createdBy    String?   @map("created_by") @db.Uuid
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  translations  ProductTranslation[]
  variants      ProductVariant[]
  images        ProductImage[]
  categories    ProductCategory[]
  supplierLinks SupplierProduct[]

  @@index([supplierId])
  @@index([status])
  @@map("products")
}

model ProductTranslation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  locale         String  @db.VarChar(5)
  name           String  @db.VarChar(255)
  description    String? @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductVariant {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  sku                 String    @unique @db.VarChar(100)
  attributes          Json      @default("{}")
  barcode             String?   @db.VarChar(50)
  supplierCost        Decimal   @map("supplier_cost") @db.Decimal(12, 2)
  supplierCurrency    String    @default("USD") @map("supplier_currency") @db.VarChar(3)
  sellingPrice        Decimal   @map("selling_price") @db.Decimal(12, 2)
  sellingCurrency     String    @default("EUR") @map("selling_currency") @db.VarChar(3)
  exchangeRateAtSync  Decimal?  @map("exchange_rate_at_sync") @db.Decimal(10, 4)
  weightGrams         Int?      @map("weight_grams")
  dimensions          Json?
  availableQuantity   Int       @default(0) @map("available_quantity")
  reservedQuantity    Int       @default(0) @map("reserved_quantity")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  supplierStockStatus String    @default("unknown") @map("supplier_stock_status") @db.VarChar(20)
  status              String    @default("active") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierLinks SupplierVariant[]
  images        ProductImage[]

  @@index([productId])
  @@index([availableQuantity])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.Text
  altText   Json?    @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model SupplierProduct {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  externalProductId String    @map("external_product_id") @db.VarChar(100)
  supplierUrl       String?   @map("supplier_url") @db.Text
  supplierStatus    String    @default("active") @map("supplier_status") @db.VarChar(20)
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz(6)
  rawData           Json?     @map("raw_data")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants SupplierVariant[]

  @@unique([supplierId, externalProductId])
  @@index([productId])
  @@map("supplier_products")
}

model SupplierVariant {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierProductId String   @map("supplier_product_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  externalVariantId String   @map("external_variant_id") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, externalVariantId])
  @@index([productVariantId])
  @@map("supplier_variants")
}

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token") @db.VarChar(255)
  currency   String   @db.VarChar(3)
  status     String   @default("active") @db.VarChar(20)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items CartItem[]

  @@index([storeId, userId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                 String   @map("store_id") @db.Uuid
  userId                  String?  @map("user_id") @db.Uuid
  orderNumber             String   @map("order_number") @db.VarChar(50)
  idempotencyKey          String   @unique @map("idempotency_key") @db.VarChar(255)
  idempotencyPayloadHash  String   @map("idempotency_payload_hash") @db.VarChar(64)
  status                  String   @default("PENDING_PAYMENT") @db.VarChar(30)
  paymentStatus           String   @default("pending") @map("payment_status") @db.VarChar(30)
  currency                String   @db.VarChar(3)
  subtotal                Decimal  @db.Decimal(12, 2)
  shippingTotal           Decimal  @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal                Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal           Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal              Decimal  @map("grand_total") @db.Decimal(12, 2)
  customerEmail           String   @map("customer_email") @db.VarChar(255)
  customerPhone           String?  @map("customer_phone") @db.VarChar(50)
  shippingAddressSnapshot Json     @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?    @map("billing_address_snapshot")
  notes                   String?  @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items         OrderItem[]
  payments      Payment[]
  supplierOrder SupplierOrder?
  shipment      Shipment?
  invoices      Invoice[]
  refunds       Refund[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  variantSnapshot     Json     @map("variant_snapshot")
  quantity            Int
  unitSalePrice       Decimal  @map("unit_sale_price") @db.Decimal(12, 2)
  unitSupplierCost    Decimal  @map("unit_supplier_cost") @db.Decimal(12, 2)
  supplierCurrency    String   @map("supplier_currency") @db.VarChar(3)
  currency            String   @db.VarChar(3)
  taxRate             Decimal  @map("tax_rate") @db.Decimal(5, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  provider          String    @db.VarChar(20)
  providerPaymentId String    @map("provider_payment_id") @db.VarChar(255)
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(255)
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @db.VarChar(3)
  status            String    @default("pending") @db.VarChar(20)
  rawResponse       Json?     @map("raw_response")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason     String?   @map("failure_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([storeId])
  @@map("payments")
}

model PaymentEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String?   @map("payment_id") @db.Uuid
  provider         String    @db.VarChar(20)
  providerEventId  String    @map("provider_event_id") @db.VarChar(255)
  eventType        String    @map("event_type") @db.VarChar(100)
  payload          Json
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  processingStatus String    @default("pending") @map("processing_status") @db.VarChar(20)
  processingError  String?   @map("processing_error") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

model WebhookEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String    @db.VarChar(20)
  providerEventId  String    @map("provider_event_id") @db.VarChar(255)
  eventType        String    @map("event_type") @db.VarChar(100)
  payload          Json
  processed        Boolean   @default(false)
  processingStatus String    @default("pending") @map("processing_status") @db.VarChar(20)
  processingError  String?   @map("processing_error") @db.Text
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

model SupplierOrder {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String    @unique @map("order_id") @db.Uuid
  supplierId           String    @map("supplier_id") @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  externalOrderId      String?   @map("external_order_id") @db.VarChar(255)
  status               String    @default("pending") @db.VarChar(30)
  supplierCost         Decimal   @map("supplier_cost") @db.Decimal(12, 2)
  supplierShippingCost Decimal   @default(0) @map("supplier_shipping_cost") @db.Decimal(12, 2)
  currency             String    @db.VarChar(3)
  customInvoiceData    Json?     @map("custom_invoice_data")
  retryCount           Int       @default(0) @map("retry_count")
  lastAttemptAt        DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lastError            String?   @map("last_error") @db.Text
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(6)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order           Order               @relation(fields: [orderId], references: [id])
  items           SupplierOrderItem[]
  shipment        Shipment?
  supplierRefunds SupplierRefund[]

  @@unique([supplierId, externalOrderId])
  @@index([orderId])
  @@index([storeId])
  @@index([storeId, status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierOrderId   String  @map("supplier_order_id") @db.Uuid
  supplierVariantId String  @map("supplier_variant_id") @db.Uuid
  variantId         String  @map("variant_id") @db.Uuid
  quantity          Int
  unitCost          Decimal @map("unit_cost") @db.Decimal(12, 2)
  currency          String  @db.VarChar(3)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
  @@index([variantId])
  @@index([supplierVariantId])
  @@map("supplier_order_items")
}

model Shipment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String    @unique @map("order_id") @db.Uuid
  supplierOrderId String    @unique @map("supplier_order_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  carrier         String?   @db.VarChar(100)
  trackingNumber  String?   @map("tracking_number") @db.VarChar(255)
  trackingUrl     String?   @map("tracking_url") @db.Text
  status          String    @default("pending") @db.VarChar(30)
  shippedAt       DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order           @relation(fields: [orderId], references: [id])
  supplierOrder SupplierOrder   @relation(fields: [supplierOrderId], references: [id])
  events        ShipmentEvent[]

  @@index([storeId])
  @@index([storeId, status])
  @@map("shipments")
}

model ShipmentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId      String   @map("shipment_id") @db.Uuid
  externalEventId String?  @map("external_event_id") @db.VarChar(255)
  status          String   @db.VarChar(30)
  description     String?  @db.Text
  location        String?  @db.VarChar(255)
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, externalEventId])
  @@index([shipmentId])
  @@map("shipment_events")
}

model Invoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  invoiceNumber String   @map("invoice_number") @db.VarChar(50)
  invoiceType   String   @default("sale") @map("invoice_type") @db.VarChar(20)
  currency      String   @db.VarChar(3)
  subtotal      Decimal  @db.Decimal(12, 2)
  taxTotal      Decimal  @map("tax_total") @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  documentUrl   String?  @map("document_url") @db.Text
  status        String   @default("issued") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([storeId, invoiceNumber])
  @@map("invoices")
}

model Refund {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  paymentId        String    @map("payment_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  amount           Decimal   @db.Decimal(12, 2)
  currency         String    @db.VarChar(3)
  reason           String?   @db.Text
  status           String    @default("pending") @db.VarChar(20)
  providerRefundId String?   @map("provider_refund_id") @db.VarChar(255)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([storeId])
  @@index([paymentId])
  @@index([storeId, status])
  @@map("refunds")
}

model SupplierRefund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierOrderId  String   @map("supplier_order_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @db.VarChar(3)
  status           String   @default("pending") @db.VarChar(20)
  externalRefundId String?  @map("external_refund_id") @db.VarChar(255)
  reason           String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])

  @@index([supplierId])
  @@map("supplier_refunds")
}

model FinancialTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  orderId         String?  @map("order_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(30)
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(3)
  referenceType   String?  @map("reference_type") @db.VarChar(50)
  referenceId     String?  @map("reference_id") @db.Uuid
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([storeId, transactionType])
  @@index([orderId])
  @@map("financial_transactions")
}

model BackgroundJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType     String    @map("job_type") @db.VarChar(100)
  payload     Json?
  status      String    @default("queued") @db.VarChar(20)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lastError   String?   @map("last_error") @db.Text
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, scheduledAt])
  @@map("background_jobs")
}

model IntegrationLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration     String   @db.VarChar(50)
  operation       String   @db.VarChar(100)
  requestSummary  Json?    @map("request_summary")
  responseStatus  Int?     @map("response_status")
  responseSummary Json?    @map("response_summary")
  success         Boolean
  errorMessage    String?  @map("error_message") @db.Text
  durationMs      Int?     @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([integration, createdAt])
  @@map("integration_logs")
}
